  "cards": [
    {
      "dot": "cyan",
      "title": "颜色来源的第三代",
      "items": [
        "顶点色(03-05)→逐像素公式(06-08)→纹理采样(09)",
        "纹理把颜色从公式里解耦：换图不换着色器"
      ]
    },
    {
      "dot": "emerald",
      "title": "采样器管什么",
      "items": [
        "uv 落在纹素之间时由过滤模式决定取值（linear 插值）",
        "uv 越界时由寻址模式决定回绕——本实验用 clamp 锁边"
