      "row": 2
    },
    {
      "id": "mix",
      "type": "backend",
      "label": "mix(red, blue, t)",
      "sublabel": "逐通道线性插值",
      "stage": 2,
      "row": 1,
      "tag": "核心原语"
    },
    {
      "id": "out",
      "type": "external",
      "label": "红→蓝渐变",
