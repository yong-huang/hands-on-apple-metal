      "labelAt": [
        298,
        234
      ]
    },
    {
      "id": "red-in",
      "from": "red",
      "to": "mix",
      "variant": "default",
      "label": "t = 0 端"
    },
    {
      "id": "blue-in",
      "from": "blue",
      "to": "mix",
      "variant": "default",
      "label": "t = 1 端"
    },
    {
      "id": "pixels",
      "from": "mix",
      "to": "out",
      "label": "插值结果",
      "variant": "emphasis"
    }
