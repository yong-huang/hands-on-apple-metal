  "flows": [
    {
      "id": "x-to-t",
      "from": "uvx",
      "to": "weight",
      "label": "横向位置",
      "variant": "default"
    },
    {
      "id": "t-to-mix",
      "from": "weight",
      "to": "mix",
      "label": "t ∈ 0…1",
