  "cards": [
    {
      "dot": "cyan",
      "title": "渐变 = 两端颜色 + 权重",
      "items": [
        "mix(a, b, t) 是着色器里最常用的插值原语，t 决定偏向哪端",
        "权重换成 smoothstep 后，渐变在首尾减速，观感更柔和"
      ]
    },
    {
      "dot": "emerald",
      "title": "举一反三",
      "items": [
        "把 uv.x 换成 uv.y 得到竖直渐变，换成 length(uv) 得到径向渐变",
        "棋盘(06)、圆(07)、渐变(08)共用同一套全屏四边形脚手架"
      ]
    }
  ]
