      "to": "screen",
      "label": "1 次 draw",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "为什么实例化",
      "items": [
        "draw call 本身是 CPU→GPU 的昂贵命令",
        "几何一份、差异一份，400 个物体 1 次 draw"
      ]
    },
    {
      "dot": "emerald",
      "title": "[[instance_id]]",
      "items": [
        "顶点着色器按实例编号查实例缓冲",
