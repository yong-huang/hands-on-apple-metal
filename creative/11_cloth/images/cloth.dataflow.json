    },
    {
      "id": "solve",
      "type": "backend",
      "label": "距离约束求解",
      "sublabel": "两端各拉回偏差一半",
      "stage": 2,
      "row": 2
    },
    {
      "id": "screen",
      "type": "external",
      "label": "应变着色渲染",
      "sublabel": "绿→黄→红 · 60 FPS",
      "stage": 3,
      "row": 2
    }
