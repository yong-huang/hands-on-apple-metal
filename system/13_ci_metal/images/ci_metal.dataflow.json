      "stage": 2,
      "row": 1,
      "tag": "GPU"
    },
    {
      "id": "mtl",
      "type": "external",
      "label": "MTLTexture",
      "sublabel": "CIImage(texture:) 互通",
      "stage": 3,
      "row": 1
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "src",
      "to": "hue",
      "label": "输入图",
      "variant": "emphasis"
    },
    {
      "id": "f2",
      "from": "hue",
      "to": "expo",
      "label": "色相输出",
      "variant": "default",
      "labelDy": 24
    },
    {
      "id": "f3",
      "from": "expo",
      "to": "render",
      "label": "滤镜结果",
      "variant": "emphasis"
    },
    {
      "id": "f5",
      "from": "render",
      "to": "mtl",
      "label": "纹理互通",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "滤镜链全程在 GPU",
      "items": [
        "CIContext(mtlDevice:) 让 Core Image 跑在同一块 Metal 设备上",
        "CIHueAdjust → CIExposureAdjust 无 CPU 中转"
      ]
    },
    {
      "dot": "emerald",
      "title": "互操作两条路",
      "items": [
        "CIImage(texture:) 把 MTLTexture 包进滤镜链",
        "ciContext.render 输出到 MTLTexture 供后续 Metal Pass 使用",
        "回读像素做差验证：91% 像素被修改"
      ]
    }
  ]
