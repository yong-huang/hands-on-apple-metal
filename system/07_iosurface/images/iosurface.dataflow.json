      "row": 2,
      "tag": "GPU"
    },
    {
      "id": "cictx",
      "type": "messagebus",
      "label": "CIImage → CIContext",
      "sublabel": "linearSRGB 回读 100%",
      "stage": 3,
      "row": 1
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "iosurface",
      "to": "cpu",
      "label": "直接读基址",
      "variant": "emphasis"
    },
    {
      "id": "f2",
      "from": "iosurface",
      "to": "mtltex",
      "label": "包装纹理",
      "variant": "default"
    },
    {
      "id": "f3",
      "from": "mtltex",
