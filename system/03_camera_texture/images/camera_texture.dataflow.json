  "cards": [
    {
      "dot": "cyan",
      "title": "零拷贝的代价",
      "items": [
        "CVMetalTextureCache 是像素缓冲与 Metal 纹理间的零拷贝桥梁",
        "合成缓冲必须显式声明 IOSurface——否则纹理创建返回 -6660（实测踩过）",
        "CPU 锁着缓冲时不能创建纹理：先填完解锁再渲染"
      ]
    },
    {
      "dot": "emerald",
      "title": "权限降级",
      "items": [
        "相机未授权时自动回退合成帧，管线验证不被阻塞",
        "四种滤镜：原图/黑白/反色/漫画量化+边缘"
      ]
    }
  ]
